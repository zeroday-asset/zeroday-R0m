+
 static DEFINE_MUTEX(pid_caches_mutex);
 static struct kmem_cache *pid_ns_cachep;
 /* MAX_PID_NS_LEVEL is needed for limiting size of 'struct pid' */
@@ -113,6 +117,15 @@
 	kref_init(&ns->kref);
 	ns->level = level;
 	ns->parent = get_pid_ns(parent_pid_ns);
+#ifdef CONFIG_KSU_SUSFS
+	/* A new unprivileged user/PID namespace must not bypass global hiding.
+	 * Trust only global root in the KernelSU domain, or an already trusted
+	 * container's descendants (including nested Docker user namespaces).
+	 */
+	ns->susfs_container = parent_pid_ns->susfs_container ||
+		(uid_eq(current_euid(), GLOBAL_ROOT_UID) &&
+		 susfs_is_current_ksu_domain());
+#endif
