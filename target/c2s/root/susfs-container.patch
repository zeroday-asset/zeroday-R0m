diff --git a/fs/susfs.c b/fs/susfs.c
--- a/fs/susfs.c
+++ b/fs/susfs.c
@@ -22,12 +22,26 @@
 #include <linux/jump_label.h>
 #include <linux/version.h> // We need check kernel version.
 #include <linux/susfs.h>
+#include <linux/pid_namespace.h>
 #include "fuse/fuse_i.h"
 #include "mount.h"
 
 extern bool susfs_is_current_ksu_domain(void);
 extern void setup_selinux(const char *domain, struct cred *cred);
 extern struct cred *ksu_cred;
+
+/* Containers need real mount metadata after leaving the KernelSU domain.
+ * Check the active PID namespace: unsharing mounts alone does not exempt
+ * Android apps. Every non-initial PID namespace is exempt, not just Droidspaces.
+ */
+bool susfs_is_current_in_container(void)
+{
+#ifdef CONFIG_PID_NS
+	return task_active_pid_ns(current) != &init_pid_ns;
+#else
+	return false;
+#endif
+}
 
 #ifdef CONFIG_KSU_SUSFS_ENABLE_LOG
 DEFINE_STATIC_KEY_TRUE(susfs_is_log_enabled);
