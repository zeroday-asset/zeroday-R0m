diff --git a/kernel/pid_namespace.c b/kernel/pid_namespace.c
--- a/kernel/pid_namespace.c
+++ b/kernel/pid_namespace.c
@@ -23,6 +23,10 @@
 #include <linux/sched/signal.h>
 #include <linux/idr.h>
 
+#ifdef CONFIG_KSU_SUSFS
